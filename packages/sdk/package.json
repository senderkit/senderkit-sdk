{
  "name": "@senderkit/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for SenderKit — notification infrastructure for modern SaaS apps.",
  "license": "MIT",
  "homepage": "https://github.com/senderkit/senderkit-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/senderkit/senderkit-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/senderkit/senderkit-sdk/issues"
  },
  "keywords": [
    "senderkit",
    "notifications",
    "transactional",
    "email",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mcp-schemas": {
      "import": {
        "types": "./dist/mcp-schemas.d.ts",
        "default": "./dist/mcp-schemas.js"
      },
      "require": {
        "types": "./dist/mcp-schemas.d.cts",
        "default": "./dist/mcp-schemas.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
