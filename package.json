{
  "name": "senderkit-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "SenderKit SDK monorepo — official TypeScript SDK and examples",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm --filter \"@senderkit/*\" build",
    "test": "pnpm --filter \"@senderkit/*\" test",
    "test:coverage": "pnpm --filter \"@senderkit/*\" test:coverage",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.2",
      "postcss": ">=8.5.10"
    }
  }
}
