{
  "name": "senderkit-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "SenderKit SDK monorepo — official TypeScript SDK and examples",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --filter \"@senderkit/*\" build",
    "test": "pnpm --filter \"@senderkit/*\" test",
    "test:coverage": "pnpm --filter \"@senderkit/*\" test:coverage",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1"
  }
}
